{
  "name": "etroy-one",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "eTroy One: integrated identity UI, OIDC provider and Swagger API documentation",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run build:ui && tsx watch src/index.ts",
    "build": "npm run docs:generate && npm run build:ui && npm run build:server",
    "start": "node dist/src/index.js",
    "lint": "eslint \"src/**/*.ts\" && npm run lint --workspace ui",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md,mjs}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md,mjs}\"",
    "dev:ui": "npm run dev --workspace ui",
    "build:ui": "npm run build --workspace ui",
    "build:server": "tsc -p tsconfig.json",
    "docs:generate": "node scripts/generate-openapi.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "ioredis": "^5.4.1",
    "mongoose": "^8.13.2",
    "nodemailer": "^10.3.1",
    "oidc-provider": "^9.8.2",
    "pino": "^10.3.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.11",
    "@types/nodemailer": "^8.0.0",
    "@types/oidc-provider": "^9.5.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "workspaces": [
    "ui"
  ]
}
